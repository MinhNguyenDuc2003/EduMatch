server {
  listen 80;
  server_name 160.30.113.224;

  # Docker DNS resolver
  resolver 127.0.0.11;

  location /swagger-ui/ {
    proxy_pass http://swagger-ui/;
  }

  location /customer/ {
    proxy_pass http://customer/;
  }

  location /location/ {
    proxy_pass http://location/;
  }

  location /profile/ {
    proxy_pass http://profile/;
  }

  location /backoffice/ {
    proxy_pass http://backoffice/;
  }

  location /edufront/ {
    proxy_pass http://edufront/;
  }

  location /pgadmin/ {
    proxy_pass http://pgadmin/;
  }

  location /identity/ {
    proxy_pass http://identity/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    if ($uri ~ "^(.*)/(protocol/openid-connect/auth|login/oauth2/code)(.*)") {
      add_header Access-Control-Allow-Origin *;
    }
  }
}
